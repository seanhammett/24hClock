{
  "manifest_version": 3,
  "name": "Analogous Clock",
  "version": "1.7.0",
  "description": "24-hour analog clock with day/night shading, moon phase, and up to twelve time zones on one dial. Click the icon to open it.",
  "action": {
    "default_title": "Open the 24-hour clock"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "permissions": ["storage"],
  "minimum_chrome_version": "123",
  "optional_permissions": ["tabs"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
